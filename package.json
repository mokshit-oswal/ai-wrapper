{
  "name": "ai-wrapper",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-account AI web platforms + local workspace assist for Mac",
  "author": "AI Wrapper",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "dist": "npm run build && env -u ELECTRON_RUN_AS_NODE electron-builder --mac",
    "dist:dir": "npm run build && env -u ELECTRON_RUN_AS_NODE electron-builder --mac --dir",
    "test": "vitest run",
    "test:smoke": "env -u ELECTRON_RUN_AS_NODE node scripts/smoke-add-account.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json"
  },
  "build": {
    "appId": "com.aiwrapper.desktop",
    "productName": "AI Wrapper",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": ["universal"]
        },
        {
          "target": "zip",
          "arch": ["universal"]
        }
      ],
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "electron": "^35.1.2",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.0.0",
    "playwright": "^1.61.1",
    "typescript": "^5.8.2",
    "vitest": "^3.0.9"
  }
}
